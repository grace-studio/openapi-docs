{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "target": "ES2023",
    "types": [
      "node"
    ],
    "module": "node16",
    "esModuleInterop": true,
    "moduleResolution": "node16"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
