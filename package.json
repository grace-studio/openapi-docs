{
  "name": "@grace-studio/openapi-docs",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "bin": {
    "openapi-docs": "./lib/index.js"
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "lint": "eslint src tests && prettier --check src tests",
    "build": "rm -rf lib && tsc",
    "test": "npm run build && node --test tests/",
    "dev": "npm run build && node lib/index.js -f ./testfiles/test.json ./testfiles/test2.json ./testfiles/test3.yml",
    "prepack": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grace-studio/openapi-docs.git"
  },
  "bugs": {
    "url": "https://github.com/grace-studio/openapi-docs/issues"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
